/* ---------------------------------------------------------
   ⏱️ TIMER + GYRO
   ---------------------------------------------------------
   fftimerg(speed, time);                 : วิ่งหน้า ตามเวลา (Gyro)
   bbtimerg(speed, time);                 : ถอย ตามเวลา (Gyro)

   fftimerg(speed, time, 'select') ;        : หน้า + Gyro + เลือกโหมด
   bbtimerg(speed, time, 'select');         : ถอย + Gyro + เลือกโหมด
--------------------------------------------------------- */

/* ---------------------------------------------------------
   🟦 BG MODE (Balance Gyro)
   ---------------------------------------------------------
   ffbg(speed, 'select');   : วิ่งหน้า โหมด BG
   bbbg(speed, 'select');   : ถอย โหมด BG
--------------------------------------------------------- */

/* ---------------------------------------------------------
   ⏱️ TIMER G
   ---------------------------------------------------------
   fftg(speed, time);                 : วิ่งหน้า Timer Gyro
   bbtg(speed, time);                : ถอย Timer Gyro

   fftg(speed, time, 'select');         : หน้า + Timer Gyro + โหมด
   bbtg(speed, time, 'select') ;        : ถอย + Timer Gyro + โหมด
--------------------------------------------------------- */

/* ---------------------------------------------------------
   📏 CM + GS (Encoder + Gyro Smooth)
   ---------------------------------------------------------
   ffcmgs(speed, distance_cm);             : หน้า ตามระยะ (GS)
   bbcmgs(speed, distance_cm);             : ถอย ตามระยะ (GS)

   ffcmgs(speed, distance_cm, 'select');     : หน้า + GS + โหมด
   bbcmgs(speed, distance_cm, 'select');     : ถอย + GS + โหมด
--------------------------------------------------------- */

/* ---------------------------------------------------------
   📏 CM + GYRO
   ---------------------------------------------------------
   ffcmg(speed, distance_cm);              : หน้า ตามระยะ Gyro
   bbcmg(speed, distance_cm);              : ถอย ตามระยะ Gyro

   ffcmg(speed, distance_cm, 'select');      : หน้า + Gyro + โหมด
   bbcmg(speed, distance_cm, 'select');      : ถอย + Gyro + โหมด
--------------------------------------------------------- */

/* ---------------------------------------------------------
   📐 CM + GYRO (Smooth / Normal)
   ---------------------------------------------------------
   ffcmgyros(speed, distance_cm, 'select');  : หน้า Gyro Smooth
   bbcmgyros(speed, distance_cm, 'select');  : ถอย Gyro Smooth

   ffcmgyro(speed, distance_cm, 'select');   : หน้า Gyro ปกติ
   bbcmgyro(speed, distance_cm, 'select');   : ถอย Gyro ปกติ
--------------------------------------------------------- */

/* ---------------------------------------------------------
   📐 DISTANCE + GYRO
   ---------------------------------------------------------
   ffdg(speed, 'select', distance_cm);       : หน้า ระยะ Gyro
   bbdg(speed, 'select', distance_cm);       : ถอย ระยะ Gyro
--------------------------------------------------------- */

/* ---------------------------------------------------------
   🔄 SPIN (หมุนด้วยองศา Gyro)
   ---------------------------------------------------------
   spinlg(angle);              : หมุนซ้าย (องศา)
   spinrg(angle);              : หมุนขวา (องศา)

   spinlg(speed, angle);       : หมุนซ้าย กำหนดความเร็ว
   spinrg(speed, angle);       : หมุนขวา กำหนดความเร็ว
--------------------------------------------------------- */

/* ---------------------------------------------------------
   ↪️ TURN (เลี้ยวด้วย Gyro)
   ---------------------------------------------------------
   turnlg(angle);              : เลี้ยวซ้าย
   turnrg(angle);              : เลี้ยวขวา
   turnlbg(angle);             : เลี้ยวซ้ายถอย
   turnrbg(angle);             : เลี้ยวขวาถอย

   turnlg(speed, angle);       : เลี้ยวซ้าย + ความเร็ว
   turnrg(speed, angle);       : เลี้ยวขวา + ความเร็ว
   turnlbg(speed, angle);      : เลี้ยวซ้ายถอย + ความเร็ว
   turnrbg(speed, angle);      : เลี้ยวขวาถอย + ความเร็ว
--------------------------------------------------------- */

/* ---------------------------------------------------------
   🔤 SHORT NAME (S = Spin / T = Turn)
   ---------------------------------------------------------
   slg(angle);      : Spin Left Gyro
   srg(angle);      : Spin Right Gyro
   tlg(angle);      : Turn Left Gyro
   trg(angle) ;     : Turn Right Gyro
   tlbg(angle);     : Turn Left Back Gyro
   trbg(angle);     : Turn Right Back Gyro

   slg(speed, angle);
   srg(speed, angle);
   tlg(speed, angle);
   trg(speed, angle);
   tlbg(speed, angle);
   trbg(speed, angle);
--------------------------------------------------------- */

