/* =========================================================
   📘 BASIC TIME MOVE COMMAND MANUAL
   คำสั่งเคลื่อนที่พื้นฐาน ควบคุมด้วย “เวลา”
   ========================================================= */

/* ---------------------------------------------------------
   ⏱️ MOVE BY TIME (ms)
   ---------------------------------------------------------
   fd(speed, time_ms)   : วิ่งหน้า ตามเวลา
   bk(speed, time_ms)   : ถอยหลัง ตามเวลา

   sl(speed, time_ms)   : หมุนซ้าย ตามเวลา
   sr(speed, time_ms)   : หมุนขวา ตามเวลา

   tl(speed, time_ms)   : เลี้ยวซ้าย (โค้ง)
   tr(speed, time_ms)   : เลี้ยวขวา (โค้ง)
--------------------------------------------------------- */
/* =========================================================
   🏁 ตัวอย่างใช้งาน
   fd(60, 800);   // วิ่งหน้า 0.8 วินาที
   sl(50, 300);   // หมุนซ้าย
   fd(40, 500);   // วิ่งหน้าอีกนิด
   ========================================================= */
/* ---------------------------------------------------------
   🔄 SPIN : หมุนหุ่นยนต์
   ---------------------------------------------------------
   spinl(speed);      : หมุนซ้าย
   spinr(speed);      : หมุนขวา
   spinl2(speed);     : หมุนซ้ายแรง
   spinr2(speed);     : หมุนขวาแรง

   spinl_b(speed);    : หมุนซ้ายถอย
   spinr_b(speed);    : หมุนขวาถอย
   spinl2_b(speed);   : หมุนซ้ายแรง (ถอย)
   spinr2_b(speed);   : หมุนขวาแรง (ถอย)

   spinl();           : หมุนซ้าย (ใช้ tspd)
   spinr();           : หมุนขวา (ใช้ tspd)
   spinl2();          : หมุนซ้ายแรง (ใช้ tspd)
   spinr2();          : หมุนขวาแรง (ใช้ tspd)
--------------------------------------------------------- */
/*
========================================================================================
  7️⃣ ตารางคำสั่งเมื่อเจอแยก (Command Table)
========================================================================================*
 *   's' : หยุดธรรมดา
 *   'S' : หยุดแบบล็อคมอเตอร์ (ไม่ควรใช้บ่อย)
 *   'q' || 'Q': เลี้ยวซ้ายทันที
 *   'e' || 'E' : เลี้ยวขวาทันที
 *   'l' || 'L' เดินหน้าจนเซนเซอร์ใต้ล้อเจอเส้นแล้วเลี้ยวซ้าย
 *   'r' || 'R': เดินหน้าจนเซนเซอร์ใต้ล้อเจอเส้นแล้วเลี้ยวขวา
 *   'c' || 'C' : เดินหน้าจนเซนเซอร์ใต้ล้อเจอเส้นแล้วหยุด
 *   'p' || 'P' : เดินหน้าจนเซนเซอร์แผงหน้าพ้นแยก
 *   'b' || 'B' : เดินหน้าจนเซนเซอร์แผงหลังเจอเส้น
 *   'z' : เซนเซอร์แผงหลังเลี้ยวซ้ายถอยหลัง (ล้อเดียว)
 *   'x' : เซนเซอร์แผงหลังเลี้ยวขวาถอยหลัง (ล้อเดียว)
 *   'a' || 'A': เดินหน้าจนเซนเซอร์ใต้ล้อเจอเส้น แล้วเลี้ยวซ้ายโดยใช้เซนเซอร์หลัง
 *   'd' || 'D': เดินหน้าจนเซนเซอร์ใต้ล้อเจอเส้น แล้วเลี้ยวขวาโดยใช้เซนเซอร์หลัง
 *   'g' || 'G': หยุดแบบใช้ไจโร
*/
/* ---------------------------------------------------------
   ⏱️ TIMER : วิ่งตามเวลา
   ---------------------------------------------------------
   fftimer(speed, time);           : วิ่งหน้าตามเวลา
   bbtimer(speed, time);           : ถอยตามเวลา
   fft(speed, time);               : ย่อจาก fftimer
   bbt(speed, time);               : ย่อจาก bbtimer

   fftimer(speed, time, 'select');   : วิ่งหน้า + เลือกโหมด
   bbtimer(speed, time, 'select');   : ถอย + เลือกโหมด
--------------------------------------------------------- */

/* ---------------------------------------------------------
   📏 DISTANCE : วิ่งตามระยะ
   ---------------------------------------------------------
   ffcm(speed, distance);              : วิ่งหน้าตามระยะ
   bbcm(speed, distance);              : ถอยตามระยะ
   ffcm(speed, distance, 'select');      : วิ่งหน้า + โหมด
   bbcm(speed, distance, 'select');      : ถอย + โหมด
--------------------------------------------------------- */

/* ---------------------------------------------------------
   ➡️ STRAIGHT : วิ่งตรง (ไม่จับเส้น)
   ---------------------------------------------------------
   ff(speed, 'select');   : วิ่งหน้า
   bb(speed, 'select');   : ถอย
--------------------------------------------------------- */

/* ---------------------------------------------------------
   🧭 LINE FOLLOW : วิ่งตามเส้น (หน้า)
   ---------------------------------------------------------
   ffl(speed, 'select');     : ซ้าย
   ffl2(speed, 'select');    : ซ้าย
   ffl0(speed, 'select');    : ซ้าย เซนเซอร์ 0 ตัวเดียว
   ffr(speed, 'select');     : ขวา 
   ffr2(speed, 'select');    : ขวา
   ffr7(speed, 'select');    : ขวา เซนเซอร์ 7 ตัวเดียว
   ffc(speed, 'select');     : กลาง
   ffc2(speed, 'select');    : กลาง
   ffn(speed, 'select', n);  : เลือกเซนเซอร์
--------------------------------------------------------- */

/* ---------------------------------------------------------
   🧭 LINE FOLLOW : ถอยหลัง
   ---------------------------------------------------------
   bbl(speed, 'select');
   bbl2(speed, 'select');
   bbl0(speed, 'select');
   bbr(speed, 'select');
   bbr2(speed, 'select');
   bbr7(speed, 'select');
   bbc(speed, 'select');
   bbc2(speed, 'select');
   bbn(speed, 'select', n);
--------------------------------------------------------- */

/* ---------------------------------------------------------
   ⚫⚪ COLOR : ตรวจสีเส้น
   ---------------------------------------------------------
   ffblack(speed, 'select'); / ffb();   : หน้าเจอเส้นดำ
   ffwhite(speed, 'select'); / ffw();   : หน้าเจอเส้นขาว
   bbblack(speed, 'select'); / bbb();   : ถอยเจอเส้นดำ
   bbwhite(speed, 'select'); / bbw();   : ถอยเจอเส้นขาว
--------------------------------------------------------- */

/* ---------------------------------------------------------
   📐 SENSOR DISTANCE
   ---------------------------------------------------------
   ffd(speed, 'select', distance);     : วิ่งหน้าตามระยะ
   ffds(speed, 'select', ir_target);   : วิ่งหน้าเจอค่า IR
   bbd(speed, 'select', distance) ;    : ถอยตามระยะ
--------------------------------------------------------- */



/* ---------------------------------------------------------
   ⚖️ BALANCE / SETUP
   ---------------------------------------------------------
   balancef(1);  : ปรับสมดุลวิ่งหน้า
   balanceb(1);  : ปรับสมดุลถอย
   setf(1) ;     : ตั้งค่าด้านหน้า
   setb(1) ;     : ตั้งค่าด้านหลัง
   set_f(1);      : ตั้งค่าด้านหน้า
   set_b(1);      : ตั้งค่าด้านหลัง
--------------------------------------------------------- */


